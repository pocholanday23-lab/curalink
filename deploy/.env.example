# Copy to the app's `.env` on the VPS and fill in real values.
# DATABASE_URL / DATABASE_URL_UNPOOLED: copy verbatim from your local .env
# (they point at the Neon "Employee Database" project).

DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?channel_binding=require&sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?channel_binding=require&sslmode=require"

# Generate a fresh one for production:  openssl rand -base64 33
AUTH_SECRET="replace-me"

# Public URL of this deployment (used by Auth.js). Must be the HTTPS domain.
AUTH_URL="https://hr.curalink.pro"
AUTH_TRUST_HOST="true"

# Outbound email (admin -> members: account invites, payslip-ready notices).
# For the poch@curalink.pro mailbox on Hostinger:
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="poch@curalink.pro"
SMTP_PASS="the-mailbox-password"
EMAIL_FROM="Curalink HR <poch@curalink.pro>"
