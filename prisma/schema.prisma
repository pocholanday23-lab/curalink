// Prisma schema for the timesheet / payroll / invoicing app
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  EMPLOYEE
  MANAGER
  ADMIN
}

enum MaritalStatus {
  SINGLE
  MARRIED
  SEPARATED
  WIDOWED
  DIVORCED
}

enum BankAccountType {
  SAVINGS
  CHECKING
}

enum CutoffType {
  SEMI_MONTHLY
  BIWEEKLY
  WEEKLY
  CUSTOM
}

enum PayPeriodStatus {
  OPEN
  CLOSED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  REST_DAY
}

model User {
  id                 String   @id @default(cuid())
  name               String
  username           String   @unique
  firstName          String?
  lastName           String?
  email              String   @unique
  passwordHash       String
  mustChangePassword Boolean  @default(true)
  role               Role     @default(EMPLOYEE)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())

  managerId String?
  manager   User?   @relation("ManagerToEmployees", fields: [managerId], references: [id])
  reports   User[]  @relation("ManagerToEmployees")

  profile EmployeeProfile?

  assignments       Assignment[]
  timeEntries       TimeEntry[]
  attendanceRecords AttendanceRecord[]

  @@index([managerId])
}

model EmployeeProfile {
  id                     String           @id @default(cuid())
  userId                 String           @unique
  user                   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  middleName             String?
  salaryUsd              Decimal?         @db.Decimal(12, 2)
  salaryPhp              Decimal?         @db.Decimal(12, 2)
  birthDate              DateTime?        @db.Date
  contactNumber          String?
  homeAddress            String?
  maritalStatus          MaritalStatus?
  spouseName             String?
  sssNo                  String?
  tinNo                  String?
  pagibigNo              String?
  bankName               String?
  bankBranch             String?
  bankAccountName        String?
  bankAccountNumber      String?
  bankType               BankAccountType?
  emergencyContactName   String?
  emergencyContactNumber String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  dependents Dependent[]
}

model Dependent {
  id        String          @id @default(cuid())
  profileId String
  profile   EmployeeProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name      String
  birthDate String?

  @@index([profileId])
}

model Client {
  id           String   @id @default(cuid())
  name         String
  contactName  String?
  contactEmail String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  assignments    Assignment[]
  clientInvoices ClientInvoice[]
}

model Assignment {
  id          String    @id @default(cuid())
  employeeId  String
  employee    User      @relation(fields: [employeeId], references: [id])
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id])
  projectName String?
  payRate     Decimal   @db.Decimal(10, 2)
  billRate    Decimal   @db.Decimal(10, 2)
  startDate   DateTime
  endDate     DateTime?
  active      Boolean   @default(true)

  timeEntries TimeEntry[]

  @@index([employeeId])
  @@index([clientId])
}

model TimeEntry {
  id           String    @id @default(cuid())
  employeeId   String
  employee     User      @relation(fields: [employeeId], references: [id])
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  clockIn      DateTime
  clockOut     DateTime?
  notes        String?

  @@index([employeeId])
  @@index([assignmentId])
  @@index([clockIn])
}

model CutoffConfig {
  id         String     @id @default(cuid())
  type       CutoffType @default(SEMI_MONTHLY)
  anchorDate DateTime
  params     Json?
  updatedAt  DateTime   @updatedAt
}

model PayPeriod {
  id        String          @id @default(cuid())
  startDate DateTime
  endDate   DateTime
  payDate   DateTime
  status    PayPeriodStatus @default(OPEN)

  @@unique([startDate, endDate])
}

model AttendanceRecord {
  id         String           @id @default(cuid())
  employeeId String
  employee   User             @relation(fields: [employeeId], references: [id])
  date       DateTime         @db.Date
  status     AttendanceStatus
  updatedAt  DateTime         @updatedAt

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
}

model CompanySettings {
  id                String   @id @default("default")
  name              String
  registrationId    String?
  invoiceAddress    String?
  payslipAddress    String?
  logoUrl           String?
  bankName          String?
  bankAccountName   String?
  bankAccountNumber String?
  bankBranch        String?
  bankAddress       String?
  swiftCode         String?
  serviceChargePct  Decimal  @default(10) @db.Decimal(5, 2)
  updatedAt         DateTime @updatedAt
}

model ClientInvoice {
  id                String    @id @default(cuid())
  number            String    @unique
  clientId          String
  client            Client    @relation(fields: [clientId], references: [id])
  invoiceDate       DateTime
  currency          String    @default("USD")
  billToName        String
  billToAddress     String?
  coverageNote      String?
  lineItems         Json
  totalAmount       Decimal   @db.Decimal(14, 2)
  payPeriodIds      String[]
  billedFrom        DateTime? @db.Date
  billedTo          DateTime? @db.Date
  previousInvoiceId String?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([clientId])
}
